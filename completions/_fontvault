#compdef fontvault

_fontvault() {
  local -a commands
  commands=(
    'init:configure the private backup repository'
    'setup:guide a new Mac through GitHub access and repository setup'
    'backup:classify, snapshot, commit, and push'
    'status:show backup and Git status'
    'doctor:check dependencies and configuration'
    'restore:restore fonts or Homebrew packages'
    'schedule:install the daily LaunchAgent'
    'unschedule:remove the LaunchAgent'
    'apps:print the application inventory'
    'homebrew:print the Homebrew inventory'
    'logs:show automatic-backup logs'
    'version:show the installed version'
  )

  if (( CURRENT == 2 )); then
    _describe 'command' commands
    return
  fi

  case "$words[2]" in
    init)
      _arguments '--repo[backup repository path]:directory:_directories'
      ;;
    setup)
      _arguments \
        '--account[GitHub username]:username:' \
        '--repo-name[private repository name]:repository:' \
        '--path[local repository path]:directory:_directories' \
        '--non-interactive[print requirements without prompting]'
      ;;
    backup)
      _arguments \
        '--dry-run[classify without modifying the repository]' \
        '--local[update the local snapshot without commit or push]' \
        '--commit[commit without pushing]' \
        '--push[commit and push]' \
        '--include-shared[include /Library/Fonts]' \
        '--yes[accept the displayed change summary without prompting]'
      ;;
    restore)
      _arguments \
        '1:mode:(fonts homebrew all)' \
        '--overwrite[overwrite conflicting font files]' \
        '--skip-existing[keep installed items]' \
        '--non-interactive[use safe non-interactive defaults]' \
        '--upgrade-homebrew[allow Homebrew upgrades]' \
        '--yes[confirm the restore plan]' \
        '--shared[restore shared fonts]'
      ;;
    schedule)
      _arguments '--daily[daily time]:time (HH\:MM):'
      ;;
    logs)
      _arguments '--errors[show the error log]'
      ;;
  esac
}

_fontvault "$@"

